    </base_channel_configuration>
    <!-- channelConfigs[3] = 154g: IEEE 802.15.4g SUN-FSK, EU 863-870 MHz, 2-FSK 50 kbps, mod. index 1.0
         (Wi-SUN FAN 1.0 EU PHY mode 1b / operating mode #1, 100 kHz channel spacing, ch0 = 863.1 MHz).
         Select the matching PHY in the "IEEE 802.15.4 SUN FSK" (or Wi-SUN FAN) profile; name TO VERIFY. -->
    <base_channel_configuration name="154g" profile="IEEE802154_SUN_FSK">
      <channel_config_entries>
        <channel_config_entry name="863.1-870.0 MHz (ch0-69, 100 kHz)">
          <channel_number_start>0</channel_number_start>
          <channel_number_end>69</channel_number_end>
          <physical_channel_offset>SAME_AS_FIRST_CHANNEL</physical_channel_offset>
          <max_power>RAIL_TX_POWER_MAX</max_power>
          <metadata>{"selectedPhy":"PHY_IEEE802154_SUN_FSK_863MHz_2FSK_50kbps_mi1p0"}</metadata>
          <base_frequency>863100000</base_frequency>
          <channel_spacing>100000</channel_spacing>
        </channel_config_entry>
      </channel_config_entries>
      <metadata>{"selectedPhy":"PHY_IEEE802154_SUN_FSK_863MHz_2FSK_50kbps_mi1p0"}</metadata>
      <profile_inputs>
        <input><key>base_frequency_hz</key><value>863100000</value></input>
        <input><key>channel_spacing_hz</key><value>100000</value></input>
        <input><key>xtal_frequency_hz</key><value>39000000</value></input>
        <input><key>rx_xtal_error_ppm</key><value>10</value></input>
        <input><key>tx_xtal_error_ppm</key><value>10</value></input>
      </profile_inputs>
    </base_channel_configuration>
