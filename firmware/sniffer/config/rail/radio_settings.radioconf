<?xml version="1.0" encoding="UTF-8"?>
<!--
  ionos-maximus sniffer: multi-PHY radio configuration (EFR32FG23, BRD4265B)
  SPDX-License-Identifier: MIT  (c) 2026 Zoltan Doczi (HA7DCD), Zoltan Papp - Z2 Labs

  AUTHORED BY HAND, NOT YET ROUND-TRIPPED THROUGH THE RADIO CONFIGURATOR.
  The protocol entries are in pktlink_phy_t order (pktlink.h) and must
  stay so, because sniffer.c indexes channelConfigs[] by that order. If
  Simplicity Studio refuses the file, delete it and recreate the ten
  protocols from the recipe in README.md ("Radio configuration"), in the
  same order, then re-save. The "Mbus" and SUN-FSK entries are selected
  by their configurator PHY name; the configurator fills in the detailed
  profile inputs itself. The generic FSK entries are complete.
-->
<multi_phy_configuration part_family="ocelot" part_revision="A0" rail_adapter_version="rail_api_2.x" status_code="0" xsd_version="0.0.20">
  <base_channel_configurations>
    <!-- channelConfigs[0] = wmbus_tc: WMbus TC M2O (100k, frameA); + RAIL_WMBUS_Config() for T+C(+frame B) RX -->
    <base_channel_configuration name="wmbus_tc" profile="Mbus">
      <channel_config_entries>
        <channel_config_entry name="868.950 MHz (single channel)">
          <channel_number_start>0</channel_number_start>
          <channel_number_end>0</channel_number_end>
          <physical_channel_offset>SAME_AS_FIRST_CHANNEL</physical_channel_offset>
          <max_power>RAIL_TX_POWER_MAX</max_power>
          <metadata>{"selectedPhy":"PHY_wMbus_ModeTC_M2O_100k_frameA"}</metadata>
          <base_frequency>868950000</base_frequency>
          <channel_spacing>1000000</channel_spacing>
        </channel_config_entry>
      </channel_config_entries>
      <metadata>{"selectedPhy":"PHY_wMbus_ModeTC_M2O_100k_frameA"}</metadata>
      <profile_inputs>
        <input><key>base_frequency_hz</key><value>868950000</value></input>
        <input><key>channel_spacing_hz</key><value>1000000</value></input>
        <input><key>xtal_frequency_hz</key><value>39000000</value></input>
        <input><key>rx_xtal_error_ppm</key><value>10</value></input>
        <input><key>tx_xtal_error_ppm</key><value>10</value></input>
      </profile_inputs>
    </base_channel_configuration>
    <!-- channelConfigs[1] = wmbus_s: WMbus S (32.768k, Manchester); PHY name TO VERIFY in the configurator -->
